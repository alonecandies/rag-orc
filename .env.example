# ---------------------------------------------------------------------------
# rag-orc configuration. Copy to .env and fill in the LLM key.
#
# Nesting uses a double underscore: RAGORC_<SECTION>__<FIELD>.
# Every field in ragorc/core/settings.py is reachable this way.
# ---------------------------------------------------------------------------

RAGORC_ENVIRONMENT=dev
RAGORC_DEBUG=false

# --- LLM (OpenRouter) ------------------------------------------------------
# The only credential you must supply. https://openrouter.ai/keys
RAGORC_LLM__API_KEY=sk-or-v1-REPLACE_ME

# The cost cascade (ADR-0005): fast_model handles the 10-40 classification calls
# per query, model writes the answer, strong_model is escalation only.
RAGORC_LLM__MODEL=anthropic/claude-sonnet-4.5
RAGORC_LLM__FAST_MODEL=google/gemini-2.5-flash-lite
RAGORC_LLM__STRONG_MODEL=anthropic/claude-opus-4.5
RAGORC_LLM__MAX_CONCURRENCY=16
# "price" routes to the cheapest provider serving the model.
RAGORC_LLM__PROVIDER_SORT=price
# "deny" excludes providers that train on prompts. Keep this for internal docs.
RAGORC_LLM__DATA_COLLECTION=deny

# --- Embeddings (local by default; OpenRouter has no embeddings endpoint) ---
RAGORC_EMBEDDING__PROVIDER=fastembed
RAGORC_EMBEDDING__DENSE_MODEL=BAAI/bge-small-en-v1.5
RAGORC_EMBEDDING__SPARSE_MODEL=Qdrant/bm25
RAGORC_EMBEDDING__RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# For late chunking, switch to a long-context model:
# RAGORC_EMBEDDING__DENSE_MODEL=jinaai/jina-embeddings-v2-base-en

# --- Host ports for docker compose ----------------------------------------
# Only needed when a port is already taken on your machine. The container-side
# ports never change; these only change what the host publishes. Remember to
# update the DSN/URI below to match.
# RAGORC_PG_PORT=5433
# RAGORC_NEO4J_BOLT_PORT=7687
# RAGORC_QDRANT_HTTP_PORT=6333
# RAGORC_QDRANT_GRPC_PORT=6334

# --- Stores ---------------------------------------------------------------
RAGORC_QDRANT__URL=http://localhost:6333
RAGORC_QDRANT__PREFER_GRPC=true
RAGORC_QDRANT__COLLECTION=ragorc

RAGORC_POSTGRES__DSN=postgresql://ragorc:ragorc@localhost:5432/ragorc
# Read-only role used for Text-to-SQL execution (defence in depth, ADR-0006).
RAGORC_POSTGRES__READONLY_DSN=postgresql://ragorc_ro:ragorc_ro@localhost:5432/ragorc

RAGORC_NEO4J__URI=bolt://localhost:7687
RAGORC_NEO4J__USER=neo4j
RAGORC_NEO4J__PASSWORD=ragorcpass

# --- Cache ----------------------------------------------------------------
# Set the Redis URL once more than one worker serves traffic, otherwise each
# worker warms its own cache and the hit rate divides by the worker count.
# RAGORC_CACHE__REDIS_URL=redis://localhost:6379/0
RAGORC_CACHE__SEMANTIC_ENABLED=true
RAGORC_CACHE__SEMANTIC_THRESHOLD=0.97

# --- Feature switches -----------------------------------------------------
RAGORC_RETRIEVAL__HYBRID_ENABLED=true
RAGORC_RETRIEVAL__RERANK_ENABLED=true
RAGORC_RETRIEVAL__CRAG_ENABLED=false
RAGORC_GENERATION__SELF_RAG_ENABLED=false
RAGORC_GRAPH__ENABLED=false
RAGORC_INDEXING__CHUNKING_STRATEGY=auto
RAGORC_INDEXING__SPLITTER=semantic
RAGORC_INDEXING__RAPTOR_ENABLED=false

# --- Cost ceilings (enforced before each call, not after) -----------------
RAGORC_COST__MAX_COST_PER_QUERY_USD=0.50
RAGORC_COST__MAX_LLM_CALLS_PER_QUERY=40

# --- Security -------------------------------------------------------------
RAGORC_SECURITY__ENABLE_SQL_GUARD=true
RAGORC_SECURITY__ENABLE_CYPHER_GUARD=true
RAGORC_SECURITY__ENABLE_INJECTION_DETECTION=true
RAGORC_SECURITY__INJECTION_ACTION=sanitize
RAGORC_SECURITY__ENABLE_PII_REDACTION=false
# Fails closed: a query with no tenant_id is rejected rather than searching
# every tenant's data. This also gates generated SQL and Cypher, which refuse to
# run unless the deployment declares how tenants are isolated.
#
# Left at the code default (on) rather than pre-set to false. This file is meant
# to be copied to .env, so a value here is the value a deployment gets, and
# shipping `false` under a comment that says "fails closed" handed every copy an
# open one. Uncomment for a genuinely single-tenant deployment.
# RAGORC_SECURITY__ENFORCE_TENANT_ISOLATION=false
# How isolation is enforced for *generated* SQL/Cypher. Those legs cannot be
# scoped by this library (it does not know your schema), so with isolation on
# they refuse unless you declare the mechanism. See docs/security.md.
#   reject (default) | rls | database | trusted
# RAGORC_SECURITY__GENERATED_QUERY_ISOLATION=rls

# --- Observability --------------------------------------------------------
RAGORC_OBSERVABILITY__LOG_LEVEL=INFO
RAGORC_OBSERVABILITY__LOG_JSON=true
# Off by default: prompts contain retrieved customer data.
RAGORC_OBSERVABILITY__LOG_PROMPTS=false

# --- Server ---------------------------------------------------------------
RAGORC_SERVER__PORT=8000
# RAGORC_SERVER__API_KEYS=["change-me"]

# --- Optional: web fallback for CRAG active retrieval ---------------------
# TAVILY_API_KEY=
