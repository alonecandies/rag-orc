# Hand-written eval set over examples/corpus/ (the fictional Halcyon Data handbook).
# Format: one ragorc.eval.dataset.EvalCase per line. Blank lines and lines starting
# with '#' are skipped by EvalDataset.load.
#
# `expected_chunk_ids` is empty on every case on purpose. Chunk ids are derived from
# the chunk's *content* (ragorc.core.ids.chunk_id), so they change with the splitter,
# the chunk size and any edit to the corpus — a hard-coded id would silently become
# unmatchable and report a recall regression that is really a config change.
# `metadata.source_document` carries the document a correct answer must come from,
# which is stable across splitter changes and is the label to use for a document-level
# recall check. Chunk-level retrieval metrics come from the synthetic set instead, which
# ragorc.eval.dataset generates against the live index and labels with real chunk ids;
# this file is the answer-quality and abstention set. See examples/06_evaluation.py.
#
# tags: single_hop | multi_hop | aggregation | unanswerable | pricing | policy | late_chunking
{"id": "hd-expense-approver", "question": "Who has to approve an expense claim above \u20ac500 at Halcyon Data?", "expected_answer": "Dana Okafor, the Head of Finance. Above \u20ac5,000 it needs Dana Okafor and the VP of the requesting area.", "expected_chunk_ids": [], "metadata": {"source_document": "02-expenses-policy.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-per-diem", "question": "What is the per-diem rate for travel outside the EU?", "expected_answer": "\u20ac80 per day outside the EU, versus \u20ac60 per day inside it. Travel days count at half rate, and the per-diem replaces meal receipts rather than being claimed alongside them.", "expected_chunk_ids": [], "metadata": {"source_document": "02-expenses-policy.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-reimburse-window", "question": "How long does Finance take to pay an approved expense claim?", "expected_answer": "Within 15 business days of approval, on the next payment run.", "expected_chunk_ids": [], "metadata": {"source_document": "02-expenses-policy.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-sev1-definition", "question": "What counts as a SEV-1 incident?", "expected_answer": "Customer data is exposed or lost, or the platform is wholly unavailable. A SEV-1 opens an incident channel, pages the on-call primary and notifies Priya Raman within 15 minutes.", "expected_chunk_ids": [], "metadata": {"source_document": "03-security-policy.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-prod-access", "question": "What second factor is required for production access, and is an authenticator app enough?", "expected_answer": "A hardware security key is required for production. Software TOTP is accepted only for internal tools, never for production.", "expected_chunk_ids": [], "metadata": {"source_document": "03-security-policy.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-engine-price", "question": "How much does Retrieval Engine cost, and what does the price cover?", "expected_answer": "1,200 US dollars per month per environment. Document storage and query volume are included; embedding throughput is billed separately as Embedding Credits.", "expected_chunk_ids": [], "metadata": {"source_document": "04-retrieval-engine.md", "tags": ["single_hop", "pricing"]}}
{"id": "hd-graph-seat-price", "question": "How much does the Graph Add-on cost per seat per month?", "expected_answer": "450 US dollars per month per seat. It cannot be bought on its own: the environment must already run Retrieval Engine 3.0 or later.", "expected_chunk_ids": [], "metadata": {"source_document": "05-graph-addon.md", "tags": ["single_hop", "pricing", "late_chunking"], "note": "The answering sentence starts with the pronoun 'It' and never names the product; the antecedent is three paragraphs earlier. Early chunking loses the referent, late chunking keeps it."}}
{"id": "hd-credit-pack", "question": "What do you get for one Embedding Credits pack?", "expected_answer": "One credit pack costs 90 US dollars and covers 10 million embedded tokens. Packs do not expire.", "expected_chunk_ids": [], "metadata": {"source_document": "06-embedding-credits.md", "tags": ["single_hop", "pricing"]}}
{"id": "hd-credit-burn", "question": "Our embedding bill is too high. What should we look at first, query volume or how often we re-index?", "expected_answer": "The re-ingest schedule. Indexing embeds a document's full text while a query embeds only the question, so ingest dominates. Checksum skipping makes re-ingesting an unchanged document free, so rebuilding an index from scratch nightly is the usual cause.", "expected_chunk_ids": [], "metadata": {"source_document": "06-embedding-credits.md", "tags": ["single_hop", "pricing"]}}
{"id": "hd-platinum-sev1", "question": "What is the SEV-1 response time on the Platinum support plan?", "expected_answer": "30 minutes, with 24x7 coverage. Response means a named engineer has acknowledged the ticket and started work; it is not a resolution commitment.", "expected_chunk_ids": [], "metadata": {"source_document": "07-support-plans.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-deprecation-window", "question": "Once a capability is deprecated, how long does it keep working?", "expected_answer": "It is announced at a minor release, keeps working for two further minor releases and is removed at the third - roughly three months at the current cadence. Removals are never patched in.", "expected_chunk_ids": [], "metadata": {"source_document": "09-release-process.md", "tags": ["single_hop", "policy"]}}
{"id": "hd-multihop-graph-oncall", "question": "Contoso Ltd bought one product in addition to Retrieval Engine. Who is the on-call primary for the service that product runs on?", "expected_answer": "Tomas Lindqvist. Contoso runs the Graph Add-on, the Graph Add-on runs in the Graph Service, and Tomas Lindqvist owns that service and is its on-call primary.", "expected_chunk_ids": [], "metadata": {"source_document": "10-customer-accounts.md", "supporting_documents": ["05-graph-addon.md", "08-engineering-oncall.md"], "tags": ["multi_hop"]}}
{"id": "hd-multihop-fabrikam-sla", "question": "What SEV-1 response time is Fabrikam GmbH entitled to?", "expected_answer": "2 hours. Fabrikam GmbH is on the Gold support plan, and Gold commits to a 2-hour SEV-1 response with 24x5 coverage.", "expected_chunk_ids": [], "metadata": {"source_document": "10-customer-accounts.md", "supporting_documents": ["07-support-plans.md"], "tags": ["multi_hop"]}}
{"id": "hd-multihop-graph-owner-am", "question": "Who is the account manager for the only documented customer that uses the Graph Add-on?", "expected_answer": "Elena Cruz. Contoso Ltd is the only documented account using the Graph Add-on, and Elena Cruz owns that account.", "expected_chunk_ids": [], "metadata": {"source_document": "10-customer-accounts.md", "tags": ["multi_hop"]}}
{"id": "hd-multihop-design-partner-version", "question": "What minimum Retrieval Engine version does the product Contoso was the design partner for require?", "expected_answer": "Retrieval Engine 3.0 or later. Contoso was the design partner for the Graph Add-on, which requires 3.0 or later.", "expected_chunk_ids": [], "metadata": {"source_document": "10-customer-accounts.md", "supporting_documents": ["05-graph-addon.md", "04-retrieval-engine.md"], "tags": ["multi_hop"]}}
{"id": "hd-multihop-graph-outage", "question": "If the Graph Service goes down, what severity is that and who gets paged first?", "expected_answer": "SEV-2, because queries degrade to passage ranking rather than failing. The on-call primary for the Graph Service, Tomas Lindqvist, is paged first, with the secondary paged after 10 minutes without acknowledgement.", "expected_chunk_ids": [], "metadata": {"source_document": "08-engineering-oncall.md", "supporting_documents": ["03-security-policy.md", "05-graph-addon.md"], "tags": ["multi_hop"]}}
{"id": "hd-aggregate-platinum-count", "question": "How many of the documented customers are on the Platinum support plan, and which ones?", "expected_answer": "Two: Northwind Traders and Contoso Ltd. Both are enterprise segment.", "expected_chunk_ids": [], "metadata": {"source_document": "10-customer-accounts.md", "supporting_documents": ["07-support-plans.md"], "tags": ["aggregation", "multi_hop"]}}
{"id": "hd-aggregate-services", "question": "How many services does engineering run an on-call rotation for, and what are they?", "expected_answer": "Four: the Query Gateway, the Index Service, the Graph Service and the Billing Service.", "expected_chunk_ids": [], "metadata": {"source_document": "08-engineering-oncall.md", "tags": ["aggregation"]}}
{"id": "hd-unanswerable-parental-leave", "question": "How many weeks of paid parental leave does Halcyon Data offer?", "expected_answer": "The available documents do not say. Halcyon Data's handbook and policies here cover expenses, security, support, on-call and releases; parental leave is not documented.", "expected_chunk_ids": [], "metadata": {"source_document": null, "answerable": false, "tags": ["unanswerable", "abstention"], "note": "Adjacent to the policy documents in vocabulary, so retrieval returns plausible neighbours. The correct behaviour is to abstain, not to synthesize a number from the expense thresholds."}}
{"id": "hd-unanswerable-tokyo-region", "question": "Which cloud region hosts the Tokyo deployment of the Index Service?", "expected_answer": "The available documents do not say. The Index Service is documented as a service with an owner and an on-call rotation, but no deployment regions or a Tokyo presence are described anywhere in the corpus.", "expected_chunk_ids": [], "metadata": {"source_document": null, "answerable": false, "tags": ["unanswerable", "abstention"], "note": "Every noun in the question exists in the corpus except the fact being asked for, which is the case a similarity-only retriever scores highest and a grounded generator must still decline."}}
